# Copie para .env.local na raiz de cada app (apps/site, apps/luther).

# Origem pública do Euaggelion (zona principal). Usada para redirecionar ao /login único
# e para os links de e-mail do Auth.
EUAGGELION_URL=http://localhost:3000

# Zonas (multi-zones): para onde a zona principal (apps/site) encaminha cada app
LUTHER_ORIGIN=http://localhost:3001

# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Somente servidor (lê app_memberships e faz administração). Nunca use prefixo NEXT_PUBLIC_.
SUPABASE_SECRET_KEY=

# DeepSeek (somente servidor)
DEEPSEEK_API_KEY=

# Mailgun (e-mails transacionais)
MAILGUN_API_KEY=
MAILGUN_DOMAIN=
MAILGUN_FROM=
