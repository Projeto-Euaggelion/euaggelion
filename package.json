{
  "name": "euaggelion",
  "private": true,
  "packageManager": "pnpm@10.28.0",
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "dev:luther": "pnpm --filter luther dev",
    "import:convert": "pnpm --filter @euaggelion/importer convert --",
    "import:apply": "pnpm --filter @euaggelion/importer apply --"
  },
  "devDependencies": {
    "turbo": "^2",
    "typescript": "^5"
  }
}
